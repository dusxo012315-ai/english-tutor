# Deployment preparation: never point this build at the original reading-room-demo.db.
DB_MODE=local
DATABASE_PATH=./data/deployment-local.db
DATABASE_PURPOSE=test
DEV_SEED=false
# Cloud/Preview: DB_MODE=libsql and a separate TEST database only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Use the exact origin. Preview needs its stable HTTPS alias.
APP_URL=http://127.0.0.1:3000
AUTH_ENABLED=true
# Generated scrypt hash and random signing secret; server-only, never NEXT_PUBLIC_.
APP_PASSWORD_HASH=
AUTH_SECRET=
WIKIPEDIA_MODE=live
TUTOR_MODE=companion
# APP_MODE is obsolete and ignored. OpenAI variables are unused; do not deploy a key.
